<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">

                <h4 class="card-title">Datatable Editable</h4>
                <div class="d-flex justify-content-end mb-3">
                    <button id="addLineBtn" class="btn btn-primary">
                        <i class="fas fa-plus"></i>
                    </button>
                </div>
                <div class="table-responsive">
                    <table id="tblDataLine" class="table table-editable table-nowrap align-middle table-edits" ">
                        <thead>
                            <tr>
                                <th >Line Id</th>
                                <th >Line Name</th>
                                <th>Note</th>
                                <th>Edit</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div> <!-- end col -->
</div> <!-- end row -->
<!-- Modal for Adding a New Line -->


<div class="modal fade" id="addLineModal" tabindex="-1" role="dialog" aria-labelledby="addLineModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addLineModalLabel">Add New Line</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="addLineForm">
                    <div class="form-group">
                        <label for="lineName">Line Name</label>
                        <input type="text" class="form-control" id="lineName" required>
                    </div>
                    <div class="form-group">
                        <label for="note">Note</label>
                        <input type="text" class="form-control" id="note" required>
                    </div>
                    <button type="submit" class="btn btn-primary">Add Line</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        var table; // Variable to store DataTable instance

        // Initialize DataTable and load data via AJAX
        $.ajax({
            url: '/api/lineApi',
            method: 'GET',
            success: function (response) {
                var data = response.data; // Data from response

                // Generate HTML based on data
                var html = '';
                data.forEach(function (item) {
                    html += '<tr data-id="' + item.LineId + '" style="cursor: pointer;">' +
                        '<td data-field="LineId">' + item.LineId + '</td>' +
                        '<td data-field="LineName">' + item.LineName + '</td>' +
                        '<td data-field="Note">' + item.Note + '</td>' +
                        '<td>' +
                        '<a class="btn btn-outline-secondary btn-sm edit" title="Edit">' +
                        '<i class="fas fa-pencil-alt" title="Edit"></i>' +
                        '</a>' +
                        '<a class="btn btn-outline-danger btn-sm delete" title="Delete">' +
                        '<i class="fas fa-trash-alt" title="Delete"></i>' +
                        '</a>' +
                        '</td>' +
                        '</tr>';
                });

                // Add HTML to the table body
                $('#tblDataLine tbody').html(html);

                // Initialize DataTables
                table = $('#tblDataLine').DataTable({
                    // DataTables configuration options
                });

                // Handle inline editing
                $('#tblDataLine tbody').on('click', '.edit', function () {
                    var $btn = $(this).find('i');
                    var $row = $(this).closest('tr');
                    var id = $row.data('id');

                    if ($btn.hasClass('fa-pencil-alt')) {
                        // Fetch data for the specific row
                        $.ajax({
                            url: '/api/lineApi/' + id,
                            method: 'GET',
                            success: function (response) {
                                var item = response.data;

                                // Populate the row with the fetched data and make it editable
                                $row.find('td[data-field="LineName"]').text(item.LineName).attr('contenteditable', 'true');
                                $row.find('td[data-field="Note"]').text(item.Note).attr('contenteditable', 'true');

                                // Switch to save mode
                                $btn.removeClass('fa-pencil-alt').addClass('fa-save').attr('title', 'Save');
                                $row.find('td[contenteditable="true"]').addClass('editable');
                            },
                            error: function (xhr, status, error) {
                                console.error('Error fetching data:', error);
                            }
                        });
                    } else {
                        // Switch to edit mode and save data
                        var updatedData = {
                            LineId: id, // Add LineId to the data object
                            LineName: $row.find('td[data-field="LineName"]').text(),
                            Note: $row.find('td[data-field="Note"]').text()
                        };

                        console.log('Updating data for ID:', id, 'with data:', updatedData);

                        $.ajax({
                            url: '/api/lineApi/'+id , // Correct URL format
                            method: 'PUT',
                            contentType: 'application/json',
                            data: JSON.stringify(updatedData),
                            success: function (response) {
                                console.log('Update successful:', response);
                                // Optionally, update the row data with response data
                                $btn.removeClass('fa-save').addClass('fa-pencil-alt').attr('title', 'Edit');
                                $row.find('td[contenteditable="true"]').removeClass('editable').attr('contenteditable', 'false');
                            },
                            error: function (xhr, status, error) {
                                console.error('Error updating data:', error);
                                // Handle error response
                            }
                        });
                    }
                });
                // Handle deletion
                $('#tblDataLine tbody').on('click', '.delete', function () {
                    var $row = $(this).closest('tr');
                    var id = $row.data('id');

                    if (confirm('Are you sure you want to delete this item?')) {
                        $.ajax({
                            url: '/api/lineApi/' + id,
                            method: 'DELETE',
                            success: function (response) {
                                console.log('Deletion successful');
                                table.row($row).remove().draw();
                            },
                            error: function (xhr, status, error) {
                                console.error('Error deleting data:', error);
                                // Handle error response
                            }
                        });
                    }
                });
                 // Handle form submission for adding a new line
            $('#addLineForm').on('submit', function (e) {
                e.preventDefault();

                var newLine = {
                    LineName: $('#lineName').val(),
                    Note: $('#note').val()
                };

                $.ajax({
                    url: '/api/lineApi',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(newLine),
                    success: function (response) {
                        console.log('Creation successful');
                        // Optionally, add the new row to the DataTable
                        var item = response;
                        var newRowHtml = '<tr data-id="' + item.LineId + '" style="cursor: pointer;">' +
                            '<td data-field="LineId">' + item.LineId + '</td>' +
                            '<td data-field="LineName">' + item.LineName + '</td>' +
                            '<td data-field="Note">' + item.Note + '</td>' +
                            '<td>' +
                            '<a class="btn btn-outline-secondary btn-sm edit" title="Edit">' +
                            '<i class="fas fa-pencil-alt" title="Edit"></i>' +
                            '</a>' +
                            '</td>' +
                            '<td>' +
                            '<a class="btn btn-outline-danger btn-sm delete" title="Delete">' +
                            '<i class="fas fa-trash-alt" title="Delete"></i>' +
                            '</a>' +
                            '</td>' +
                            '</tr>';
                        table.row.add($(newRowHtml)).draw();

                        $('#addLineModal').modal('hide');
                        $('#addLineForm')[0].reset();
                    },
                    error: function (xhr, status, error) {
                        console.error('Error creating data:', error);
                        // Handle error response
                    }
                });
            });
            },
            error: function (xhr, status, error) {
                console.error('Error fetching data:', error);
            }
        });
        $('#addLineBtn').on('click', function () {
        $('#addLineModal').modal('show');
    });
    });
</script>

<style>
    .editable {
        background-color: #f9f9f9;
        border: 1px solid #ddd;
    }
</style>







